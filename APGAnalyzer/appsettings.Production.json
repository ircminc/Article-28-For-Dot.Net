{
  // Production-only overrides. Loaded after appsettings.json when
  // ASPNETCORE_ENVIRONMENT=Production, which is the App Service default.
  //
  // ConnectionStrings:DefaultConnection lives in Azure App Service
  // Configuration (NOT in this file) so the secret stays out of git.
  // Override anything else here that should differ from dev.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "APGAnalyzer": "Information"
    }
  }
}
