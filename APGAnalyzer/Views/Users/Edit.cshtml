@model APGAnalyzer.Models.EditUserViewModel
@{
    ViewData["Title"] = "Edit user";
}

<div class="container py-3" style="max-width: 40rem;">
    <h1 class="h3 mb-1">Edit user</h1>
    <p class="text-muted"><code>@Model.Email</code></p>

    <form asp-action="Edit" method="post" class="card shadow-sm p-4">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Email" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label fw-semibold"></label>
            <select asp-for="Role" class="form-select">
                <option value="admin">admin — full access including user management</option>
                <option value="analyst">analyst — upload, delete, export (no user management)</option>
                <option value="viewer">viewer — read-only</option>
            </select>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsLockedOut" class="form-check-input" />
            <label asp-for="IsLockedOut" class="form-check-label">
                Locked out (denies sign-in)
            </label>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
            <a asp-action="ResetPassword" asp-route-id="@Model.Id"
               class="btn btn-outline-warning ms-auto">Reset password…</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
