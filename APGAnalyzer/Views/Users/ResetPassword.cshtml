@model APGAnalyzer.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container py-3" style="max-width: 40rem;">
    <h1 class="h3 mb-1">Reset password</h1>
    <p class="text-muted">For <code>@Model.Email</code></p>

    <form asp-action="ResetPassword" method="post" class="card shadow-sm p-4">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Email" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
            <input asp-for="NewPassword" type="text" class="form-control"
                   autocomplete="new-password" />
            <div class="form-text">
                Min 6 characters. Share this with the user through a secure channel.
                Their existing sessions will be invalidated.
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-warning">Reset password</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
